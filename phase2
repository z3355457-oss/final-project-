import os
import joblib
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import classification_report, ConfusionMatrixDisplay

# تحديد ملف البيانات والموديل الثابت بالسيستم
train_file = "train.csv"
model_path = "titanic_rf_model.pkl"

print("--- Starting Titanic Training Pipeline (Phase 2) ---")

# ------------------------------------------------------------------------------
# 1. قراءة الفايل الأساسي وتحميل البيانات
# ------------------------------------------------------------------------------
raw_data = pd.read_csv(train_file)
print(f"Data loaded successfully: {raw_data.shape[0]} rows found.")

# ------------------------------------------------------------------------------
# 2. تنظيف الخصائص ومعالجة الفراغات والقيم المفقودة
# ------------------------------------------------------------------------------
# تحديد الأعمدة المهمة التي طلبها الدكتور لتوقع النجاة
features = ['Pclass', 'Sex', 'Age', 'SibSp', 'Parch', 'Fare', 'Embarked']
X = raw_data[features].copy()
y = raw_data['Survived'].copy()

# تعبئة الفراغات بمتوسط القيم والمنوال لحماية خط تدريب الموديل لمنع الأخطاء
X['Age'] = X['Age'].fillna(X['Age'].median())
X['Fare'] = X['Fare'].fillna(X['Fare'].median())
X['Embarked'] = X['Embarked'].fillna(X['Embarked'].mode()[0])

# التشفير الاحترافي: نقوم بعمل fit على بيانات التدريب بالكامل وتحويل النصوص لأرقام
le_sex = LabelEncoder()
le_embarked = LabelEncoder()
X['Sex'] = le_sex.fit_transform(X['Sex'])
X['Embarked'] = le_embarked.fit_transform(X['Embarked'])

# حفظ أدوات التشفير (Encoders) عشان نستخدمها دايركت في الفيز الثالث للتوقعات
joblib.dump(le_sex, "gender_encoder.pkl")
joblib.dump(le_embarked, "embarked_encoder.pkl")
print("Data preprocessing completed & encoders saved successfully.")

# ------------------------------------------------------------------------------
# 3. تقسيم البيانات 80% تدريب و 20% تحقق داخلي (Stratified)
# ------------------------------------------------------------------------------
X_train, X_val, y_train, y_val = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)
print(f"Train size: {X_train.shape[0]} | Validation size: {X_val.shape[0]}")

# ------------------------------------------------------------------------------
# 4. تدريب الموديل بإعدادات عادية وبسيطة ومباشرة (Random Forest)
# ------------------------------------------------------------------------------
print("\nTraining Random Forest Classifier...")
model = RandomForestClassifier(n_estimators=100, max_depth=5, random_state=42)
model.fit(X_train, y_train)

# حساب سكور الدقة للتدريب والتحقق الداخلي
print(f"Train Accuracy Score: {model.score(X_train, y_train) * 100:.2f}%")
print(f"Validation Accuracy Score: {model.score(X_val, y_val) * 100:.2f}%")

# ------------------------------------------------------------------------------
# 5. طباعة التقرير النهائي ورسم مصفوفة الارتباك وتصديرها
# ------------------------------------------------------------------------------
print("\nGenerating Classification Report:")
preds = model.predict(X_val)
print(classification_report(y_val, preds))

# رسم مصفوفة الارتباك بدقة عالية وحفظها في مجلد reports
os.makedirs("reports", exist_ok=True)
fig, ax = plt.subplots(figsize=(6,6))
ConfusionMatrixDisplay.from_predictions(y_val, preds, cmap=plt.cm.Blues, ax=ax)
plt.title("Validation Confusion Matrix")
plt.savefig("reports/confusion_matrix.png", dpi=300)
plt.show()

# ------------------------------------------------------------------------------
# 6. حساب أهمية الخصائص وترتيبها (Feature Importance)
# ------------------------------------------------------------------------------
print("\nFeature Importance Metrics:")
importances = model.feature_importances_
for name, importance in zip(features, importances):
    print(f"-> {name:<10}: {importance * 100:.2f}%")

# ------------------------------------------------------------------------------
# 7. حفظ ملف الموديل النهائي المعتمد في المجلد الرئيسي
# ------------------------------------------------------------------------------
joblib.dump(model, model_path)
print(f"\n[SUCCESS] Final model saved to: {model_path}")
