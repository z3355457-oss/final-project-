import os
import joblib
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.metrics import classification_report, ConfusionMatrixDisplay

train_file = "train.csv"
test_file = "test.csv"
model_path = "titanic_rf_model.pkl"
submission_path = "final_titanic_predictions.csv"

# 1. تحميل المودل وأدوات التشفير المحفوظة من الفيز الثاني
loaded_model = joblib.load(model_path)
le_sex = joblib.load("gender_encoder.pkl")          # استدعاء تشفير الجنس الجاهز
le_embarked = joblib.load("embarked_encoder.pkl")    # استدعاء تشفير الميناء الجاهز
print("Model and Encoders loaded successfully.")

# 2. قراءة البيانات وتجهيزها
raw_data = pd.read_csv(train_file)
features = ['Pclass', 'Sex', 'Age', 'SibSp', 'Parch', 'Fare', 'Embarked']

X = raw_data[features].copy()
y = raw_data['Survived'].copy()

X['Age'] = X['Age'].fillna(X['Age'].median())
X['Fare'] = X['Fare'].fillna(X['Fare'].median())
X['Embarked'] = X['Embarked'].fillna(X['Embarked'].mode()[0])

# استخدام التشفير المستدعى مباشرة (بدون fit_transform)
X['Sex'] = le_sex.transform(X['Sex'])
X['Embarked'] = le_embarked.transform(X['Embarked'])

# تقسيم البيانات للحصول على نفس الفاليديشن ست
_, X_val, _, y_val = train_test_split(X, y, test_size=0.20, random_state=42, stratify=y)

# 3. حساب الدقه وطباعه تقرير التصنيف
val_preds = loaded_model.predict(X_val)
print(f"Validation Accuracy: {loaded_model.score(X_val, y_val) * 100:.2f}%")
print("\nClassification Report:")
print(classification_report(y_val, val_preds))

# 4. رسم مصفوفه الارتباك وحفظها
os.makedirs("reports", exist_ok=True)
ConfusionMatrixDisplay.from_predictions(y_val, val_preds, cmap=plt.cm.Blues)
plt.title("Validation Confusion Matrix")
plt.savefig("reports/confusion_matrix.png")
plt.show()

# 5. تنظيف ملف التست حق كاجل والتنبؤ النهائي
print("\nProcessing kaggle test file...")
test_data = pd.read_csv(test_file)
X_test = test_data[features].copy()

# تعبئة فراغات التيست بناء على الترين
X_test['Age'] = X_test['Age'].fillna(raw_data['Age'].median())
X_test['Fare'] = X_test['Fare'].fillna(raw_data['Fare'].median())
X_test['Embarked'] = X_test['Embarked'].fillna(raw_data['Embarked'].mode()[0])

# تطبيق التشفير المستدعى على ملف كاجل
X_test['Sex'] = le_sex.transform(X_test['Sex'])
X_test['Embarked'] = le_embarked.transform(X_test['Embarked'])

# التوقع النهائي وتصدير الفايل
final_predictions = loaded_model.predict(X_test)

submission_df = pd.DataFrame({
    "PassengerId": test_data["PassengerId"],
    "Survived": final_predictions
})

submission_df.to_csv(submission_path, index=False)
print(f"Process finished. Final submission saved at: {submission_path}")
